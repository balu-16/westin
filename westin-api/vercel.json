{
    "version": 2,
    "buildCommand": "npm install && npm run build",
    "crons": [
        { "path": "/api/cron/report-reminder", "schedule": "30 14 * * *" },
        { "path": "/api/cron/report-reminder", "schedule": "30 15 * * *" }
    ],
    "builds": [
        {
            "src": "src/main.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "methods": ["OPTIONS"],
            "dest": "src/main.ts"
        },
        {
            "src": "/(.*)",
            "dest": "src/main.ts"
        }
    ]
}
